{
  "method": "lengthOfLastWord",
  "cases": [
    {
      "args": ["Hello World"],
      "expected": 5
    },
    {
      "args": ["   fly me   to   the moon  "],
      "expected": 4
    },
    {
      "args": ["luffy is still joyboy"],
      "expected": 6
    },
    {
      "args": ["a"],
      "expected": 1
