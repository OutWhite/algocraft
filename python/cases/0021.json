{
  "method": "mergeTwoLists",
  "arg_types": ["linked_list", "linked_list"],
  "expected_type": "linked_list",
  "cases": [
    {
      "args": [[1, 2, 4], [1, 3, 4]],
      "expected": [1, 1, 2, 3, 4, 4]
    },
    {
      "args": [[], []],
      "expected": []
    },
    {
      "args": [[], [0]],
      "expected": [0]
    },
    {
      "args": [[-10, -3, 0, 5], [-6, -3, 2, 4]],
      "expected": [-10, -6, -3, -3, 0, 2, 4, 5]
    },
    {
      "args": [[1, 1, 2], [1, 1, 3]],
      "expected": [1, 1, 1, 1, 2, 3]
    }
  ]
}
